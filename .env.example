# Пароли Postgres и Redis, а также TG_TOKEN/WEBHOOK_SECRET/ENCRYPTION_KEY
# хранятся в Docker secrets (папка secrets/), а не в этом файле.
# Сгенерировать: см. README, раздел «Установка и запуск».

POSTGRES_USER=postgres
POSTGRES_DB=kita

WEBHOOK_DOMAIN=example.com
WEBHOOK_PORT=8443

RATELIMIT_MAX_TOKENS=5
RATELIMIT_REFILL_RATE=0.3

# Optional settings

# WEBHOOK_PATH=/webhook
# WEBHOOK_MAX_CONCURRENT_UPDATES=50

POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1200

# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0

# LOG_LEVEL="INFO"
