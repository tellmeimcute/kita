{$WEBHOOK_DOMAIN}:{$WEBHOOK_PORT} {
    @telegram_ips {
        remote_ip 149.154.160.0/20 91.108.4.0/22
    }

    handle {$WEBHOOK_PATH}* {
        handle @telegram_ips {
            reverse_proxy bot:{$BOT_PORT} {
                flush_interval -1
            }
        }
    }

    handle {
        respond "Not Found" 404
    }
}
